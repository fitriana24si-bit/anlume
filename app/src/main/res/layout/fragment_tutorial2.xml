<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_onboarding">

    <!-- Decorative shapes -->
    <View
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_marginTop="-50dp"
        android:layout_marginEnd="-100dp"
        android:alpha="0.5"
        android:background="@drawable/ic_onboarding_deco"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginStart="-30dp"
        android:layout_marginBottom="100dp"
        android:alpha="0.3"
        android:background="@drawable/ic_onboarding_deco"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <androidx.cardview.widget.CardView
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_marginBottom="40dp"
            app:cardCornerRadius="120dp"
            app:cardElevation="12dp"
            app:cardMaxElevation="15dp"
            app:cardPreventCornerOverlap="false">

            <ImageView
                android:id="@+id/ivTutorial2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="40dp"
                android:scaleType="centerInside"
                android:src="@drawable/bg_header_wave" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvTitle2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:text="Akses Produk Hukum"
            android:textAlignment="center"
            android:textColor="#1E1B4B"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDesc2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingExtra="6dp"
            android:text="Cari dan baca berbagai peraturan desa, keputusan kepala desa, dan dokumen hukum lainnya dengan mudah."
            android:textAlignment="center"
            android:textColor="#4B5563"
            android:textSize="17sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
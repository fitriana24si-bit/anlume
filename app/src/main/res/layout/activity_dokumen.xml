<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    tools:context=".Home.dokumen.DokumenActivity">

    <!-- SCROLL -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="@drawable/bg_header_dokumen"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dokumen Publik"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Layanan dokumen digital Bina Desa"
                    android:textSize="14sp"
                    android:textColor="#EDE9FE"
                    android:paddingTop="6dp"/>

            </LinearLayout>

            <!-- SEARCH -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Cari dokumen..."
                app:startIconDrawable="@android:drawable/ic_menu_search"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp"
                app:elevation="2dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- CHIP GROUP -->
            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                android:layout_marginBottom="16dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSemua"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Semua"
                    android:checked="true"
                    app:chipBackgroundColor="@color/purple_500"
                    android:textColor="@android:color/white"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPemerintah"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pemerintah" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLayanan"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Layanan" />

            </com.google.android.material.chip.ChipGroup>

            <!-- MENU UTAMA MENGGUNAKAN MATERIAL BUTTON -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginBottom="18dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdministrasi"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="Administrasi"
                    android:textAllCaps="false"
                    android:textColor="#1F2937"
                    app:icon="@android:drawable/ic_menu_edit"
                    app:iconGravity="top"
                    app:iconPadding="8dp"
                    app:iconSize="32dp"
                    app:iconTint="#673AB7"
                    app:cornerRadius="16dp"
                    app:strokeColor="#E5E7EB"
                    android:backgroundTint="#FFFFFF"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPelayanan"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="Pelayanan"
                    android:textAllCaps="false"
                    android:textColor="#1F2937"
                    app:icon="@android:drawable/ic_menu_send"
                    app:iconGravity="top"
                    app:iconPadding="8dp"
                    app:iconSize="32dp"
                    app:iconTint="#673AB7"
                    app:cornerRadius="16dp"
                    app:strokeColor="#E5E7EB"
                    android:backgroundTint="#FFFFFF"/>

            </GridLayout>

            <!-- TITLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Daftar Dokumen"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1F2937"
                android:paddingBottom="10dp"/>

            <!-- LISTVIEW -->
            <ListView
                android:id="@+id/listDokumen"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:divider="@android:color/transparent"
                android:dividerHeight="10dp"
                android:nestedScrollingEnabled="true"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
